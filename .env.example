# Copy to .env.local for development. Production values live in Cloudflare:
# runtime secrets under the Worker's Variables and Secrets, and the NEXT_PUBLIC_
# ones ALSO as build variables, because Next inlines them at build time.

# Public (safe in the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SENTRY_DSN=

# Server only
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
KIMI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RECALL_API_KEY=
RECALL_REGION=
RECALL_WEBHOOK_SECRET=
CRON_SECRET=
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
